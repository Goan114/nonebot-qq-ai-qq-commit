DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
COMMAND_START=["/"]
SUPERUSERS=["123456789"]
# NapCat/OneBot v11 反向 WebSocket：ws://127.0.0.1:8080/onebot/v11/ws
# 两端填写相同的 access token
ONEBOT_ACCESS_TOKEN=replace-with-a-random-onebot-token

FEEDBACK_GROUPS=["123456789"]
FEEDBACK_DATABASE=data/feedback.sqlite3
# 填写兼容 /chat/completions 且支持 JSON object 输出的服务
FEEDBACK_AI_BASE_URL=https://your-provider.example/v1
FEEDBACK_AI_KEY=
FEEDBACK_AI_MODEL=
# 视觉默认关闭。视觉服务留空时复用文字 AI 地址/密钥；模型必须明确填写
FEEDBACK_VISION_ENABLED=false
FEEDBACK_VISION_BASE_URL=
FEEDBACK_VISION_KEY=
FEEDBACK_VISION_MODEL=
# 填入服务商真实支持图像输入的模型 ID，可在 WebUI/管理员命令中切换
FEEDBACK_VISION_MODELS=[]
FEEDBACK_VISION_MAX_IMAGES=3
FEEDBACK_VISION_MAX_BYTES=5000000
FEEDBACK_VISION_IMAGE_HOSTS=["multimedia.nt.qq.com","gchat.qpic.cn","c2cpicdw.qpic.cn"]
# 两个独立随机密钥，每个至少 32 字符；留空分别禁用 WebUI 数据访问/Webhook
FEEDBACK_ADMIN_TOKEN=
FEEDBACK_WEBHOOK_SECRET=
FEEDBACK_GITHUB_TOKEN=
# 同一仓库可以写多条，每个分支独立轮询、推送到各自指定的群；分支名精确匹配
FEEDBACK_REPOS=[{"name":"owner/game-client","branch":"main","poll_seconds":300,"announce_groups":["123456789"]},{"name":"owner/game-client","branch":"develop","poll_seconds":120,"announce_groups":["123456789"]},{"name":"owner/game-client","branch":"release/1.0","poll_seconds":180,"announce_groups":["123456789"]},{"name":"owner/game-server","branch":"main","poll_seconds":180,"announce_groups":["123456789"]}]

FEEDBACK_FAQ_URL=https://your-game.example/faq
FEEDBACK_FAQ_PROMPT="这个问题已有明确解决方法，请先查看常见问题：{url}；解决方法：{answer}"
FEEDBACK_AUTO_RESOLVE=true
FEEDBACK_RESOLVE_THRESHOLD=0.95
FEEDBACK_AUTO_BAN=true
FEEDBACK_BAN_THRESHOLD=0.98
# true：监听目标群所有普通文本；false：只分析含关键词的消息与 /反馈 命令
FEEDBACK_LISTEN_ALL=true
FEEDBACK_COOLDOWN_SECONDS=30
# 机器人向同一目标群发送消息的最小间隔；0 关闭。各群独立，重启保留最近发送时间
FEEDBACK_SEND_COOLDOWN_SECONDS=10
